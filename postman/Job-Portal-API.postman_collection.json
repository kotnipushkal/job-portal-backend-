{
  "info": {
    "name": "Job Portal Backend API",
    "description": "Collection covering public, authenticated, and role-protected requests for the Job Portal Backend API. Set the {{baseUrl}} variable and enable cookie jar in Postman settings so the httpOnly JWT cookie persists between requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "jobId", "value": "" },
    { "key": "applicationId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - Job Seeker",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Seeker\",\n  \"email\": \"asha.seeker@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"jobseeker\",\n  \"skills\": [\"JavaScript\", \"Node.js\"],\n  \"experience\": \"1 year\"\n}"
            }
          }
        },
        {
          "name": "Register - Employer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Recruiter\",\n  \"email\": \"rahul.employer@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"employer\",\n  \"companyName\": \"Acme Corp\"\n}"
            }
          }
        },
        {
          "name": "Register - Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}"
            }
          }
        },
        {
          "name": "Register - Duplicate Email (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Seeker\",\n  \"email\": \"asha.seeker@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"jobseeker\"\n}"
            }
          }
        },
        {
          "name": "Register - Invalid Input (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            }
          }
        },
        {
          "name": "Login - Job Seeker",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"asha.seeker@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login - Employer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul.employer@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login - Wrong Password (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"asha.seeker@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },
        {
          "name": "Get Current User (/auth/me)",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Get Current User - No Cookie (expect 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Cookie", "value": "token=invalidtoken" }]
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" }
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/me" }
        },
        {
          "name": "Update My Profile (Job Seeker)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skills\": [\"JavaScript\", \"Node.js\", \"MongoDB\"],\n  \"experience\": \"1.5 years\",\n  \"education\": [\n    { \"degree\": \"B.Tech\", \"institution\": \"ABC University\", \"fieldOfStudy\": \"CSE\", \"yearOfCompletion\": 2024 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Update Profile - Attempt Role Escalation (expect 400)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create Job (Employer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Developer\",\n  \"companyName\": \"Acme Corp\",\n  \"description\": \"Build and maintain REST APIs\",\n  \"location\": \"Hyderabad, India\",\n  \"employmentType\": \"full-time\",\n  \"salaryRange\": { \"min\": 600000, \"max\": 900000 },\n  \"requiredSkills\": [\"Node.js\", \"MongoDB\", \"Express\"],\n  \"experienceRequired\": \"1-3 years\",\n  \"applicationDeadline\": \"2026-12-31\"\n}"
            }
          }
        },
        {
          "name": "Create Job - As Job Seeker (expect 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should Fail\",\n  \"companyName\": \"X\",\n  \"description\": \"X\",\n  \"location\": \"X\",\n  \"employmentType\": \"full-time\"\n}"
            }
          }
        },
        {
          "name": "Get All Jobs",
          "request": { "method": "GET", "url": "{{baseUrl}}/jobs" }
        },
        {
          "name": "Get My Jobs (Employer)",
          "request": { "method": "GET", "url": "{{baseUrl}}/jobs/employer/my-jobs" }
        },
        {
          "name": "Get Job By ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/jobs/{{jobId}}" }
        },
        {
          "name": "Update Job (Owner Employer)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/jobs/{{jobId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"open\",\n  \"salaryRange\": { \"min\": 650000, \"max\": 950000 }\n}"
            }
          }
        },
        {
          "name": "Update Job - Not Owner (expect 403)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/jobs/{{jobId}}",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Hijacked Title\"\n}" }
          }
        },
        {
          "name": "Delete Job (Owner Employer)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/jobs/{{jobId}}" }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Apply to Job (Job Seeker)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/applications/{{jobId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coverLetter\": \"I'm excited to apply for this role.\"\n}"
            }
          }
        },
        {
          "name": "Apply Again - Duplicate (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/applications/{{jobId}}",
            "body": { "mode": "raw", "raw": "{\n  \"coverLetter\": \"Second attempt\"\n}" }
          }
        },
        {
          "name": "Get My Applications (Job Seeker)",
          "request": { "method": "GET", "url": "{{baseUrl}}/applications/my" }
        },
        {
          "name": "Get Applications For a Job (Employer, Owner)",
          "request": { "method": "GET", "url": "{{baseUrl}}/applications/job/{{jobId}}" }
        },
        {
          "name": "Get Applications For a Job - Not Owner (expect 403)",
          "request": { "method": "GET", "url": "{{baseUrl}}/applications/job/{{jobId}}" }
        },
        {
          "name": "Update Application Status (Employer)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/applications/{{applicationId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"shortlisted\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get All Users",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/users" }
        },
        {
          "name": "Get User By ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/users/{{userId}}" }
        },
        {
          "name": "Suspend User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/admin/users/{{userId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"suspended\"\n}" }
          }
        },
        {
          "name": "Delete User",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/users/{{userId}}" }
        },
        {
          "name": "Get All Jobs (Admin)",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/jobs" }
        },
        {
          "name": "Get Job By ID (Admin)",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/jobs/{{jobId}}" }
        },
        {
          "name": "Delete Job (Admin)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/jobs/{{jobId}}" }
        },
        {
          "name": "Admin Route - As Job Seeker (expect 403)",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/users" }
        }
      ]
    }
  ]
}
