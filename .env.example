# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/job-portal
# or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/job-portal

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_EXPIRES_DAYS=7

# CORS (comma-separated list of allowed origins, e.g. your frontend URL)
CLIENT_ORIGIN=http://localhost:3000
